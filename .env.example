# Copy to .env (or set directly in Render's dashboard) and fill in real values.
# NEVER commit .env to git.
#
# This is ONE deployment (packages/gateway) hosting all 4 domains behind
# one process, mounted at /inventory/mcp, /customer/mcp, /sales/mcp,
# /pricing/mcp. Each mount still validates against its own Okta Custom
# Authorization Server. These are the exact same names as the original
# ProGearSalesAI backend env vars (OKTA_CUSTOMER_AUTH_SERVER_ID, etc.) —
# copy the values over as-is.

# -------------------------------------------
# Shared
# -------------------------------------------
# OKTA_DOMAIN=https://your-org.okta.com

# -------------------------------------------
# /inventory/mcp  (scopes: inventory:read, inventory:write, inventory:alert)
# -------------------------------------------
# OKTA_INVENTORY_AUTH_SERVER_ID=<authServerId>
# OKTA_INVENTORY_AUDIENCE=api://progear-inventory

# -------------------------------------------
# /customer/mcp   (scopes: customer:read, customer:lookup, customer:history)
# -------------------------------------------
# OKTA_CUSTOMER_AUTH_SERVER_ID=<authServerId>
# OKTA_CUSTOMER_AUDIENCE=api://progear-customer

# -------------------------------------------
# /sales/mcp      (scopes: sales:read, sales:quote, sales:order)
# -------------------------------------------
# OKTA_SALES_AUTH_SERVER_ID=<authServerId>
# OKTA_SALES_AUDIENCE=api://progear-sales

# -------------------------------------------
# /pricing/mcp    (scopes: pricing:read, pricing:margin, pricing:discount)
# -------------------------------------------
# OKTA_PRICING_AUTH_SERVER_ID=<authServerId>
# OKTA_PRICING_AUDIENCE=api://progear-pricing

# -------------------------------------------
# Common
# -------------------------------------------
# PORT=3000                # Render sets this automatically; only needed for local runs
# ALLOW_INSECURE=true      # LOCAL DEV ONLY — skips token validation entirely, grants all scopes on every mount

# -------------------------------------------
# NOT used by this project (leftover from the ProGearSalesAI full-stack
# backend — no LLM calls, no frontend, no outbound ID-JAG token exchange
# here; this gateway only validates incoming tokens):
# ANTHROPIC_API_KEY, CORS_ORIGINS, OKTA_AI_AGENT_ID,
# OKTA_AI_AGENT_PRIVATE_KEY, OKTA_CLIENT_ID, OKTA_MAIN_AUTH_SERVER_ID
# -------------------------------------------
