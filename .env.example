# Copy to .env (or set directly in Render's dashboard) and fill in real values.
# NEVER commit .env to git.
#
# Each of the 4 MCP servers validates Okta access tokens against its own
# Custom Authorization Server (issuer) and audience. Set OKTA_DOMAIN once
# (shared across all 4 services) plus OKTA_AUTH_SERVER_ID + OKTA_AUDIENCE
# per service, using that domain's existing values — e.g. if your Okta org
# already has OKTA_CUSTOMER_AUTH_SERVER_ID / OKTA_CUSTOMER_AUDIENCE, copy
# those values into OKTA_AUTH_SERVER_ID / OKTA_AUDIENCE on the mcp-customer
# service specifically. (Alternatively set OKTA_ISSUER directly as a full
# URL, which takes precedence over OKTA_DOMAIN + OKTA_AUTH_SERVER_ID.)

# -------------------------------------------
# Shared across all 4 services
# -------------------------------------------
# OKTA_DOMAIN=https://your-org.okta.com

# -------------------------------------------
# mcp-inventory  (scopes: inventory:read, inventory:write, inventory:alert)
# -------------------------------------------
# OKTA_AUTH_SERVER_ID=<value of your OKTA_INVENTORY_AUTH_SERVER_ID>
# OKTA_AUDIENCE=api://progear-inventory

# -------------------------------------------
# mcp-customer   (scopes: customer:read, customer:lookup, customer:history)
# -------------------------------------------
# OKTA_AUTH_SERVER_ID=<value of your OKTA_CUSTOMER_AUTH_SERVER_ID>
# OKTA_AUDIENCE=api://progear-customer

# -------------------------------------------
# mcp-sales      (scopes: sales:read, sales:quote, sales:order)
# -------------------------------------------
# OKTA_AUTH_SERVER_ID=<value of your OKTA_SALES_AUTH_SERVER_ID>
# OKTA_AUDIENCE=api://progear-sales

# -------------------------------------------
# mcp-pricing    (scopes: pricing:read, pricing:margin, pricing:discount)
# -------------------------------------------
# OKTA_AUTH_SERVER_ID=<value of your OKTA_PRICING_AUTH_SERVER_ID>
# OKTA_AUDIENCE=api://progear-pricing

# -------------------------------------------
# Common
# -------------------------------------------
# PORT=3001                # Render sets this automatically; only needed for local runs
# ALLOW_INSECURE=true      # LOCAL DEV ONLY — skips token validation entirely, grants all scopes

# -------------------------------------------
# NOT used by these servers (leftover from the ProGearSalesAI full-stack
# backend — no LLM calls, no frontend, no outbound ID-JAG token exchange here):
# ANTHROPIC_API_KEY, CORS_ORIGINS, OKTA_AI_AGENT_ID,
# OKTA_AI_AGENT_PRIVATE_KEY, OKTA_CLIENT_ID, OKTA_MAIN_AUTH_SERVER_ID
# -------------------------------------------
