# Copy to .env and fill in real values. NEVER commit .env to git.
# Run with: npm run dev -w packages/local-tester (loads .env automatically via tsx? no —
# export these in your shell, or use `npx dotenv -e .env -- npm run dev -w packages/local-tester`)

# -------------------------------------------
# Human login (Authorization Code + PKCE, confidential Web app)
# -------------------------------------------
# OKTA_DOMAIN=https://prashanth-oie.oktapreview.com
# OKTA_CLIENT_ID=<the Web app's client ID>
# OKTA_CLIENT_SECRET=<the Web app's client secret>
#
# The app's "Sign-in redirect URIs" in Okta must include:
#   http://localhost:4000/callback
# (or whatever REDIRECT_URI/PORT you override below)

# -------------------------------------------
# The agent's own identity (Okta AI Agent Governance)
# Used to sign JWT client assertions for both ID-JAG steps — no client
# secret, just this private key.
# -------------------------------------------
# OKTA_AI_AGENT_ID=wlp...
# OKTA_AI_AGENT_PRIVATE_KEY={"kty":"RSA","kid":"...", ...}

# The resource URL configured on the agent app in Okta. When set, it is sent as
# the RFC 8707 `resource` parameter on both the human login's /authorize and
# /token calls, so the user's access token comes back with the agent as its
# `aud` — that token is then what starts the ID-JAG exchange. Leave unset to
# omit `resource` entirely and keep using the ID token as the subject token.
# OKTA_AI_AGENT_AUDIENCE=https://agent.example.com

# Force which login token is presented as the ID-JAG subject token
# (`id_token` or `access_token`). Defaults to `access_token` when
# OKTA_AI_AGENT_AUDIENCE is set, `id_token` otherwise.
# OKTA_ID_JAG_SUBJECT_TOKEN=

# -------------------------------------------
# Optional: only if your org login uses a Custom Authorization Server
# instead of the org-level one for the ID-JAG step-1 request. Leave unset
# to use https://{OKTA_DOMAIN}/oauth2/v1/token.
# -------------------------------------------
# OKTA_MAIN_AUTH_SERVER_ID=

# -------------------------------------------
# Per-domain Custom Authorization Server IDs + audiences — same values as
# the gateway's own env vars.
# -------------------------------------------
# OKTA_INVENTORY_AUTH_SERVER_ID=      OKTA_INVENTORY_AUDIENCE=api://progear-inventory
# OKTA_CUSTOMER_AUTH_SERVER_ID=       OKTA_CUSTOMER_AUDIENCE=api://progear-customer
# OKTA_SALES_AUTH_SERVER_ID=          OKTA_SALES_AUDIENCE=api://progear-sales
# OKTA_PRICING_AUTH_SERVER_ID=        OKTA_PRICING_AUDIENCE=api://progear-pricing

# -------------------------------------------
# Where the deployed MCP gateway lives
# -------------------------------------------
# MCP_GATEWAY_BASE_URL=https://progear-mcp-servers.onrender.com

# -------------------------------------------
# Local server
# -------------------------------------------
# PORT=4000
# REDIRECT_URI=http://localhost:4000/callback

# PUBLIC_BASE_URL=https://progear-mcp-servers.onrender.com
#   Only needed if something in front rewrites the Host header; otherwise
#   the discovery URLs are derived from the request.
