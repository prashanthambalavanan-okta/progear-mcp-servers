{
  "name": "@progear/local-tester",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run stop --silent",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "stop": "lsof -ti:${PORT:-4000} | xargs kill 2>/dev/null; pkill -f 'tsx watch --env-file=[.]env src/server.ts' 2>/dev/null; true",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "express": "^4.21.0",
    "jose": "^5.9.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/node": "^20",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
